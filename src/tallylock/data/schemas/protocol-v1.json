{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prove protocol v1 closed contracts",
  "oneOf": [
    {"$ref": "#/$defs/manifest"},
    {"$ref": "#/$defs/result"},
    {"$ref": "#/$defs/event"},
    {"$ref": "#/$defs/inclusion"},
    {"$ref": "#/$defs/chain"}
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}(?![\\s\\S])"},
    "nullableDigest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "counter": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "nullableCounter": {"anyOf": [{"$ref": "#/$defs/counter"}, {"type": "null"}]},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}(?![\\s\\S])"},
    "profile": {"enum": ["artifacts-v1", "trace-v1"]},
    "scorerProfile": {"enum": ["recorded-only-v1", "fixture-exact-v1"]},
    "outcome": {"enum": ["completed", "failed", "aborted", "budget_exceeded"]},
    "reason": {"type": ["string", "null"]},
    "path": {"type": "string", "minLength": 1},
    "attempt": {
      "type": "object", "additionalProperties": false, "required": ["id", "sample_ids"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "sample_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}}
    },
    "dataset": {
      "type": "object", "additionalProperties": false, "required": ["name", "sha256"],
      "properties": {"name": {"type": "string"}, "sha256": {"$ref": "#/$defs/nullableDigest"}}
    },
    "model": {
      "type": "object", "additionalProperties": false, "required": ["id", "evidence", "sha256"],
      "allOf": [
        {"if": {"properties": {"evidence": {"const": "weight_digest_recorded"}}},
         "then": {"properties": {"sha256": {"$ref": "#/$defs/digest"}}}}
      ],
      "properties": {"id": {"type": "string"}, "evidence": {"enum": ["self_declared", "provider_metadata_recorded", "weight_digest_recorded"]}, "sha256": {"$ref": "#/$defs/nullableDigest"}}
    },
    "harness": {
      "type": "object", "additionalProperties": false, "required": ["name", "revision", "config"],
      "properties": {"name": {"type": "string"}, "revision": {"type": "string"}, "config": {"type": "object"}}
    },
    "generation": {
      "type": "object", "additionalProperties": false, "required": ["prompt_sha256", "parameters"],
      "properties": {"prompt_sha256": {"$ref": "#/$defs/nullableDigest"}, "parameters": {"type": "object"}}
    },
    "scorer": {
      "type": "object", "additionalProperties": false, "required": ["profile", "revision"],
      "properties": {"profile": {"$ref": "#/$defs/scorerProfile"}, "revision": {"type": "string"}}
    },
    "analysis": {
      "type": "object", "additionalProperties": false, "required": ["revision", "plan_sha256"],
      "properties": {"revision": {"type": "string"}, "plan_sha256": {"$ref": "#/$defs/nullableDigest"}}
    },
    "budget": {
      "type": "object", "additionalProperties": false, "required": ["max_calls", "max_input_tokens", "max_output_tokens"],
      "properties": {"max_calls": {"$ref": "#/$defs/nullableCounter"}, "max_input_tokens": {"$ref": "#/$defs/nullableCounter"}, "max_output_tokens": {"$ref": "#/$defs/nullableCounter"}}
    },
    "manifest": {
      "type": "object", "additionalProperties": false,
      "required": ["format", "nonce", "name", "description", "profile", "attempts", "dataset", "model", "harness", "generation", "scorer", "analysis", "budget", "stopping_rule", "metadata"],
      "properties": {
        "format": {"const": "prove.manifest.v1"}, "nonce": {"type": "string", "pattern": "^[0-9a-f]{32}(?![\\s\\S])"},
        "name": {"type": "string", "minLength": 1, "maxLength": 200}, "description": {"type": "string", "maxLength": 4000},
        "profile": {"$ref": "#/$defs/profile"}, "attempts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/attempt"}},
        "dataset": {"$ref": "#/$defs/dataset"}, "model": {"$ref": "#/$defs/model"}, "harness": {"$ref": "#/$defs/harness"},
        "generation": {"$ref": "#/$defs/generation"}, "scorer": {"$ref": "#/$defs/scorer"}, "analysis": {"$ref": "#/$defs/analysis"},
        "budget": {"$ref": "#/$defs/budget"}, "stopping_rule": {"type": "string"}, "metadata": {"type": "object"}
      }
    },
    "inventoryEntry": {
      "type": "object", "additionalProperties": false, "required": ["sha256", "bytes", "media_type", "role"],
      "properties": {"sha256": {"$ref": "#/$defs/digest"}, "bytes": {"$ref": "#/$defs/counter"}, "media_type": {"type": "string"}, "role": {"type": "string"}}
    },
    "records": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256", "bytes", "count", "tree_algorithm", "root"],
      "properties": {"path": {"const": "records.jsonl"}, "sha256": {"$ref": "#/$defs/digest"}, "bytes": {"$ref": "#/$defs/counter"}, "count": {"$ref": "#/$defs/counter"}, "tree_algorithm": {"const": "rfc9162-sha256"}, "root": {"$ref": "#/$defs/digest"}}
    },
    "resources": {
      "type": "object", "additionalProperties": false, "required": ["calls", "input_tokens", "output_tokens", "reasoning_tokens", "cached_tokens", "duration_ms"],
      "properties": {"calls": {"$ref": "#/$defs/nullableCounter"}, "input_tokens": {"$ref": "#/$defs/nullableCounter"}, "output_tokens": {"$ref": "#/$defs/nullableCounter"}, "reasoning_tokens": {"$ref": "#/$defs/nullableCounter"}, "cached_tokens": {"$ref": "#/$defs/nullableCounter"}, "duration_ms": {"$ref": "#/$defs/nullableCounter"}}
    },
    "aggregate": {
      "type": "object", "additionalProperties": false, "required": ["numerator", "denominator"],
      "properties": {"numerator": {"$ref": "#/$defs/counter"}, "denominator": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}}
    },
    "fixtureDatasetSample": {
      "type": "object", "additionalProperties": false, "required": ["id", "expected"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "expected": {"type": "string"}}
    },
    "fixtureScoreSample": {
      "type": "object", "additionalProperties": false, "required": ["id", "observed"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "observed": {"type": "string"}}
    },
    "fixtureDataset": {
      "type": "object", "additionalProperties": false, "required": ["format", "samples"],
      "properties": {"format": {"const": "prove.fixture-dataset.v1"}, "samples": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fixtureDatasetSample"}}}
    },
    "fixtureScores": {
      "type": "object", "additionalProperties": false, "required": ["format", "samples", "aggregate"],
      "properties": {"format": {"const": "prove.fixture-scores.v1"}, "samples": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fixtureScoreSample"}}, "aggregate": {"$ref": "#/$defs/aggregate"}}
    },
    "score": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256", "bytes", "profile", "aggregate"],
      "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/digest"}, "bytes": {"$ref": "#/$defs/counter"}, "profile": {"$ref": "#/$defs/scorerProfile"}, "aggregate": {"anyOf": [{"$ref": "#/$defs/aggregate"}, {"type": "null"}]}}
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["format", "registration_id", "attempt_id", "profile", "outcome", "reason", "inventory", "records", "resources", "score", "metadata"],
      "allOf": [
        {"if": {"properties": {"profile": {"const": "trace-v1"}}},
         "then": {"properties": {"resources": {"properties": {"calls": {"$ref": "#/$defs/counter"}}}}}}
      ],
      "properties": {
        "format": {"const": "prove.result.v1"}, "registration_id": {"$ref": "#/$defs/digest"}, "attempt_id": {"$ref": "#/$defs/id"}, "profile": {"$ref": "#/$defs/profile"},
        "outcome": {"$ref": "#/$defs/outcome"}, "reason": {"$ref": "#/$defs/reason"},
        "inventory": {"type": "object", "additionalProperties": {"$ref": "#/$defs/inventoryEntry"}}, "records": {"$ref": "#/$defs/records"}, "resources": {"$ref": "#/$defs/resources"},
        "score": {"anyOf": [{"$ref": "#/$defs/score"}, {"type": "null"}]}, "metadata": {"type": "object"}
      }
    },
    "usage": {
      "type": "object", "additionalProperties": false, "required": ["input_tokens", "output_tokens", "reasoning_tokens", "cached_tokens", "duration_ms"],
      "properties": {"input_tokens": {"$ref": "#/$defs/nullableCounter"}, "output_tokens": {"$ref": "#/$defs/nullableCounter"}, "reasoning_tokens": {"$ref": "#/$defs/nullableCounter"}, "cached_tokens": {"$ref": "#/$defs/nullableCounter"}, "duration_ms": {"$ref": "#/$defs/nullableCounter"}}
    },
    "event": {
      "type": "object", "unevaluatedProperties": false,
      "required": ["format", "registration_id", "attempt_id", "index", "kind"],
      "properties": {"format": {"const": "prove.event.v1"}, "registration_id": {"$ref": "#/$defs/digest"}, "attempt_id": {"$ref": "#/$defs/id"}, "index": {"$ref": "#/$defs/counter"}, "kind": {"enum": ["artifact", "sample_start", "call", "sample_end", "attempt_end"]}},
      "oneOf": [
        {"required": ["path", "sha256", "bytes"], "properties": {"kind": {"const": "artifact"}, "path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/digest"}, "bytes": {"$ref": "#/$defs/counter"}}},
        {"required": ["sample_id"], "properties": {"kind": {"const": "sample_start"}, "sample_id": {"$ref": "#/$defs/id"}}},
        {"required": ["sample_id", "call_id", "retry_of", "source", "status", "input", "output", "usage"], "properties": {"kind": {"const": "call"}, "sample_id": {"$ref": "#/$defs/id"}, "call_id": {"$ref": "#/$defs/id"}, "retry_of": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}, "source": {"type": "string"}, "status": {"enum": ["succeeded", "failed", "timeout", "refused"]}, "input": {"type": ["string", "null"]}, "output": {"type": ["string", "null"]}, "usage": {"$ref": "#/$defs/usage"}}},
        {"required": ["sample_id", "status"], "properties": {"kind": {"const": "sample_end"}, "sample_id": {"$ref": "#/$defs/id"}, "status": {"enum": ["completed", "failed", "skipped"]}}},
        {"required": ["outcome", "reason"], "properties": {"kind": {"const": "attempt_end"}, "outcome": {"$ref": "#/$defs/outcome"}, "reason": {"$ref": "#/$defs/reason"}}}
      ]
    },
    "proofs": {
      "type": "object", "additionalProperties": false, "required": ["manifest", "result"],
      "properties": {"manifest": {"type": ["string", "null"]}, "result": {"type": ["string", "null"]}}
    },
    "inclusion": {
      "type": "object", "additionalProperties": false,
      "required": ["format", "registration_id", "receipt_id", "manifest", "result", "event", "index", "size", "siblings", "proofs"],
      "properties": {
        "format": {"const": "prove.inclusion.v1"}, "registration_id": {"$ref": "#/$defs/digest"}, "receipt_id": {"$ref": "#/$defs/digest"},
        "manifest": {"$ref": "#/$defs/manifest"}, "result": {"$ref": "#/$defs/result"}, "event": {"$ref": "#/$defs/event"},
        "index": {"$ref": "#/$defs/counter"}, "size": {"$ref": "#/$defs/counter"}, "siblings": {"type": "array", "items": {"$ref": "#/$defs/digest"}}, "proofs": {"$ref": "#/$defs/proofs"}
      }
    },
    "tip": {
      "type": "object", "additionalProperties": false, "required": ["height", "hash"],
      "properties": {"height": {"$ref": "#/$defs/counter"}, "hash": {"$ref": "#/$defs/digest"}}
    },
    "node": {
      "type": "object", "additionalProperties": false, "required": ["chain", "initialblockdownload", "blocks", "headers", "verificationprogress"],
      "properties": {"chain": {"const": "main"}, "initialblockdownload": {"type": "boolean"}, "blocks": {"$ref": "#/$defs/counter"}, "headers": {"$ref": "#/$defs/counter"}, "verificationprogress": {"type": "string", "pattern": "^(0|1|0\\.[0-9]*[1-9])(?![\\s\\S])"}}
    },
    "block": {
      "type": "object", "additionalProperties": false, "required": ["hash", "header", "confirmations"],
      "properties": {"hash": {"$ref": "#/$defs/digest"}, "header": {"type": "string", "pattern": "^[0-9a-f]{160}(?![\\s\\S])"}, "confirmations": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}}
    },
    "chain": {
      "type": "object", "additionalProperties": false, "required": ["format", "exported_at", "source", "tip", "node", "blocks"],
      "properties": {"format": {"const": "prove.chain.v1"}, "exported_at": {"type": "string"}, "source": {"type": "string"}, "tip": {"$ref": "#/$defs/tip"}, "node": {"$ref": "#/$defs/node"}, "blocks": {"type": "object", "propertyNames": {"pattern": "^(0|[1-9][0-9]*)(?![\\s\\S])"}, "additionalProperties": {"$ref": "#/$defs/block"}}}
    }
  }
}
